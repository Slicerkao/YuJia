# Server-side only. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Keep mock mode on until you intentionally want paid model calls.
YOUJIA_AGENT_MODE=mock
# Chef Copilot can be enabled independently from the customer-facing agent.
YOUJIA_COPILOT_MODE=mock
# Guest dinner chat inherits YOUJIA_COPILOT_MODE unless explicitly overridden.
# YOUJIA_DINING_MODE=openai
# OPENAI_CUSTOMER_MODEL=gpt-5.6-luna
OPENAI_MODEL=gpt-5.6-luna
# Standard short-context rates per 1M tokens as of 2026-08-29.
# Re-check https://developers.openai.com/api/docs/pricing before production use.
OPENAI_INPUT_USD_PER_MILLION=0.20
OPENAI_OUTPUT_USD_PER_MILLION=1.20
